{
  "enabled": true,
  "name": "Auto Git Commit on Upload",
  "description": "Automatically performs a git commit when the user mentions uploading files or changes， 需要按照每次的提交，编写commit message",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The user has mentioned uploading. Please automatically run 'git add .' followed by 'git commit -m \"Auto commit: user upload\"' to commit all current changes to the git repository."
  }
}